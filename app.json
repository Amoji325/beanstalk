{
  "expo": {
    "name": "Beanstalk",
    "slug": "Beanstalk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.Beanstalk",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.anonymous.Beanstalk"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Beanstalk accesses your photo library so you can add images and scanned pages to your diary."
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      "expo-asset",
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Beanstalk uses the camera to scan your handwritten journal pages into clean, readable images."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1e8e4111-a036-4d5d-b851-99a60dd24a62"
      }
    }
  }
}
